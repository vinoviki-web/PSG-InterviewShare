# Data source for the app: "mock" (prototype data, default) or "supabase".
VITE_DATA_SOURCE=mock

# Supabase project (local: run `npm run db:start`, then `npx supabase status`).
# The publishable key (sb_publishable_…) is public by design; Row Level Security
# protects the data. VITE_SUPABASE_ANON_KEY (legacy) is still accepted.
# NEVER put the secret / service-role key in any VITE_ variable.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
